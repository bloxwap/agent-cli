{
  "name": "bloxwap-agent-cli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm --workspace @bloxwap/agent-cli run build",
    "lint": "npm --workspace @bloxwap/agent-cli run lint",
    "typecheck": "npm --workspace @bloxwap/agent-cli run typecheck",
    "test": "npm --workspace @bloxwap/agent-cli run test",
    "docs:generate": "npm --workspace @bloxwap/agent-cli run docs:generate",
    "test:e2e": "npm --workspace @bloxwap/agent-cli run test:e2e",
    "test:package": "npm --workspace @bloxwap/agent-cli run test:package",
    "build:binaries": "npm --workspace @bloxwap/agent-cli run build:binaries",
    "test:sandbox": "npm --workspace @bloxwap/agent-cli run test:sandbox",
    "changeset": "changeset",
    "version:packages": "changeset version && npm --workspace @bloxwap/agent-cli exec -- node scripts/sync-skill-version.mjs && npm --workspace @bloxwap/agent-cli exec -- node scripts/generate-skill.mjs",
    "pack:cli": "npm pack --workspace @bloxwap/agent-cli --pack-destination packages/agent-cli"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
