{
  "name": "bloxwap-agent-cli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/agent-cli build",
    "lint": "bun run --cwd packages/agent-cli lint",
    "typecheck": "bun run --cwd packages/agent-cli typecheck",
    "test": "bun run --cwd packages/agent-cli test",
    "docs:generate": "bun run build && node apps/docs/scripts/generate-content.mjs",
    "test:e2e": "bun run --cwd packages/agent-cli test:e2e",
    "test:package": "bun run --cwd packages/agent-cli test:package",
    "build:binaries": "bun run --cwd packages/agent-cli build:binaries",
    "test:sandbox": "bun run --cwd packages/agent-cli test:sandbox",
    "changeset": "changeset",
    "version:packages": "changeset version && bun run --cwd packages/agent-cli skill:sync-version && bun run --cwd packages/agent-cli skill:generate && node packages/agent-cli/scripts/sync-lock-version.mjs && bun install --lockfile-only",
    "version:candidate": "bun run version:packages && bun run docs:generate && bun run lint && bun run typecheck && bun run test && bun run docs:check",
    "pack:cli": "npm pack --workspace @bloxwap/agent-cli --pack-destination packages/agent-cli",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:check": "bun run --cwd apps/docs check",
    "docs:preview": "bun run --cwd apps/docs preview",
    "docs:smoke": "bun run --cwd apps/docs smoke",
    "typecheck:tsc": "bun run --cwd packages/agent-cli typecheck:tsc",
    "docs:check:tsc": "bun run --cwd apps/docs check:tsc"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "mdast-util-to-markdown": "2.1.2"
  }
}
