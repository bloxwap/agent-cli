{
  "name": "@bloxwap/agent-cli",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "agent-cli": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "SKILL.md",
    "policies",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/generate-skill.mjs && tsup src/cli.ts --format esm --clean && node scripts/finalize-build.mjs",
    "lint": "eslint .",
    "typecheck": "node scripts/tsc-or-tsrs.mjs --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-testnet.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "build:binaries": "node scripts/generate-skill.mjs && node scripts/build-binaries.mjs",
    "test:sandbox": "vitest run --config vitest.integration.config.ts",
    "skill:sync-version": "node scripts/sync-skill-version.mjs",
    "skill:generate": "node scripts/generate-skill.mjs",
    "typecheck:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "viem": "^2.57.5",
    "vitest": "^5.0.4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "dependencies": {
    "@bloxwap/hyperliquid": "^0.6.0",
    "@privy-io/node": "^0.35.0",
    "@scure/bip39": "^2.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "description": "Agent-native Hyperliquid trading CLI with user-owned Privy signing and Relay funding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/agent-cli.git",
    "directory": "packages/agent-cli"
  },
  "homepage": "https://bloxwap.github.io/agent-cli/",
  "bugs": {
    "url": "https://github.com/bloxwap/agent-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
